# Sertifika deposu MATCH_GIT_URL (Harçlıklarım ile ortak depo, AYRI branch ve
# AYRI parola; yasin 2026-10-15 kararı). Neden: öteki uygulamaların
# MATCH_PASSWORD'ü yalnız kendi secret'larında durur ve geri okunamaz; ortak
# branch onu bilmeyi gerektirirdi. Bedeli: bu branch kendi Apple Distribution
# sertifikasını üretir (takım başına sınır 3). Öteki branch'lere dokunulmaz.
# Tamamen ayrı bir depo istenirse MATCH_GIT_URL secret'ı değiştirilir; kod aynı.
git_url(ENV["MATCH_GIT_URL"])
git_branch("birdiesmash")
storage_mode("git")
type("appstore")
app_identifier(["com.birdiesmash.app"])
username(ENV["APPLE_ID"])
git_basic_authorization(ENV["MATCH_GIT_BASIC_AUTH"])
readonly(ENV["MATCH_READONLY"] == "true")
