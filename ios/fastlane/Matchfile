# Sertifika deposu MATCH_GIT_URL, Harçlıklarım ile AYNI dal (`harcliklarim`) ve
# AYNI parola (yasin kararı 2026-10-19). Neden: Apple takım başına 3 dağıtım
# sertifikasına izin veriyor ve sınır dolu; ayrı dal yeni sertifika üretmeye
# çalışıp "maximum number of Distribution certificates" ile düşüyordu. Ortak
# dalda sertifika paylaşılır, yalnız bu bundle için profil eklenir. Bedeli:
# MATCH_PASSWORD secret'ı Harçlıklarım'ınkiyle aynı olmak zorunda; o parola
# değişirse iki repoda birden güncellenir. İlk `birdiesmash` dalı boş kaldı.
git_url(ENV["MATCH_GIT_URL"])
git_branch("harcliklarim")
storage_mode("git")
type("appstore")
app_identifier(["com.birdiesmash.app"])
username(ENV["APPLE_ID"])
git_basic_authorization(ENV["MATCH_GIT_BASIC_AUTH"])
readonly(ENV["MATCH_READONLY"] == "true")
